{
    "name": "neetforge-backend",
    "version": "1.0.0",
    "description": "AI-Powered NEET 2027 Preparation Platform - Scalable Backend API",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "build": "node scripts/buildUnified.js",
        "seed": "node src/seeders/seedAll.js",
        "seed:chapters": "node src/seeders/seedChapters.js",
        "seed:questions": "node src/seeders/seedQuestions.js",
        "seed:pyq-marked-ncert": "node scripts/seedPYQMarkedNCERT.js",
        "seed:ncert-lines:sample": "node scripts/seedSampleNCERTLines.js",
        "import:mock-tests": "node scripts/importMockTestsFromJson.js",
        "backfill:test-series:chapter-original-id": "node scripts/backfillTestSeriesChapterOriginalId.js",
        "cleanup:test-series:mixed-duplicates": "node scripts/removeMixedGeneralDuplicateChapters.js",
        "migrate:test-series:single-subject-chapter": "node scripts/remapSingleSubjectSingleChapterFromTestSeriesJson.js",
        "migrate:formula-images:drive": "node scripts/migrateFormulaCardImagesToGoogleDrive.js",
        "migrate:formula-images:drive:dry": "node scripts/migrateFormulaCardImagesToGoogleDrive.js --dry-run",
        "formula:enhance:gemini": "node scripts/updateFormulaCardImagesWithGemini.js",
        "formula:enhance:gemini:dry": "node scripts/updateFormulaCardImagesWithGemini.js --dry-run",
        "migrate:mock-pdfs:drive": "node scripts/migrateMockTestPdfsToGoogleDrive.js",
        "migrate:mock-pdfs:drive:dry": "node scripts/migrateMockTestPdfsToGoogleDrive.js --dry-run",
        "migrate:mock-tests:taxonomy-v2": "node scripts/migrateMockTestsTaxonomyV2.js",
        "migrate:ncert-content-source": "node scripts/normalizeNcertContentSource.js",
        "pdf:clean-topperessentials-watermark": "node scripts/cleanTopperEssentialsPdfWatermark.js",
        "pdf:process:memoneet": "node scripts/processMemoneetMockPdfsInPlace.js",
        "pdf:rollback:memoneet-inplace": "node scripts/rollbackMemoneetInPlaceChanges.js",
        "pdf:rebuild-topperessentials": "node scripts/rebuildTopperEssentialsPdfs.js",
        "feed:bio12:english": "node scripts/feedClass12BiologyEnglishUrls.js",
        "test": "jest --watchAll --verbose",
        "formula:hindi:test": "node scripts/generateHindiFormulaCardImages.js",
        "formula:hindi:apply": "node scripts/generateHindiFormulaCardImages.js --apply"
    },
    "keywords": [
        "neet",
        "jee",
        "exam-prep",
        "ai-learning",
        "mern"
    ],
    "author": "NEETForge Team",
    "license": "MIT",
    "dependencies": {
        "@google/generative-ai": "^0.21.0",
        "axios": "^1.13.6",
        "bcryptjs": "^2.4.3",
        "colors": "^1.4.0",
        "compression": "^1.7.4",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-mongo-sanitize": "^2.2.0",
        "express-rate-limit": "^7.1.5",
        "express-validator": "^7.0.1",
        "firebase-admin": "^13.7.0",
        "google-auth-library": "^10.6.2",
        "googleapis": "^171.4.0",
        "helmet": "^7.1.0",
        "http": "^0.0.1-security",
        "jsonwebtoken": "^9.0.2",
        "moment": "^2.30.1",
        "moment-timezone": "^0.6.1",
        "mongoose": "^8.0.3",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
        "node-cron": "^3.0.3",
        "pdf-lib": "^1.17.1",
        "pdf-parse": "^1.1.1",
        "pdfkit": "^0.17.2",
        "razorpay": "^2.9.6",
        "socket.io": "^4.8.3",
        "sqlite3": "^6.0.1",
        "stripe": "^14.10.0",
        "winston": "^3.11.0"
    },
    "devDependencies": {
        "jest": "^29.7.0",
        "nodemon": "^3.0.2",
        "supertest": "^6.3.3"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    }
}
